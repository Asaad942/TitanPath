{
  "name": "titanpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.ts",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && electron --no-sandbox -r ts-node/register/transpile-only src/main/main.ts",
    "build": "vite build",
    "start": "electron --no-sandbox -r ts-node/register/transpile-only src/main/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "electron": "^28.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  }
}
